# --- LLM provider: Groq — powers the AI agent ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Twilio (optional; required only if an agency connects WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public URL of this server (no trailing slash). Used for lead links, media,
# and Twilio webhook signature checks. e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=

# Session cookie. Required — the app will not boot with an empty/default value.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to false for local http://localhost. HTTPS PUBLIC_BASE_URL implies true.
COOKIE_SECURE=false

# --- Supabase (Postgres + Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
STORAGE_BUCKET=property-media

# Encrypts agency Twilio tokens at rest. Required to use Connect WhatsApp.
# Must be a Fernet key (not a random hex string). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
