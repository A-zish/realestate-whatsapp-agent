# --- LLM provider: Groq (free) — powers the AI agent ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (optional; only if you swap the agent back to Claude) ---
ANTHROPIC_API_KEY=

# --- Twilio (WhatsApp sandbox) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox "from" number. The default Twilio WhatsApp sandbox number is below.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Sheets (datastore + dashboard) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# --- Branding ---
BUILDER_NAME=Your Builder Name
AGENT_NAME=Priya

# --- Admin panel (manage property inventory) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Public URL of this server (your host/tunnel), used to serve uploaded property
# images so Twilio can fetch them. No trailing slash. e.g. https://xxx.trycloudflare.com
PUBLIC_BASE_URL=
