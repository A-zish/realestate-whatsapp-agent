# --- LLM provider: Groq (free) — powers the AI agent ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (optional; only if you swap the agent back to Claude) ---
ANTHROPIC_API_KEY=

# --- Twilio (WhatsApp sandbox) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox "from" number. The default Twilio WhatsApp sandbox number is below.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Google Sheets (datastore + dashboard) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# --- Branding ---
BUILDER_NAME=Your Builder Name
AGENT_NAME=Priya

# --- Admin panel (manage property inventory) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Public URL of this server (your host/tunnel), used to serve uploaded property
# images so Twilio can fetch them. No trailing slash. e.g. https://xxx.trycloudflare.com
PUBLIC_BASE_URL=

# --- Supabase (multi-tenant SaaS: Postgres + Auth + Storage) ---
# From your Supabase project: Settings -> API (URL + anon key) and
# Settings -> Database (connection string, "Session pooler" URI is fine).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Settings -> API -> service_role (secret). Only used server-side for Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Random string used to sign the app's own session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
STORAGE_BUCKET=property-media

# Encrypts agency Twilio tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
